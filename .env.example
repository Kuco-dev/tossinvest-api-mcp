# ─────────────────────────────────────────────────────────────
# 토스증권 Open API 인증 정보 (WTS > 설정 > Open API 에서 발급)
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env 는 커밋 금지입니다.
# ─────────────────────────────────────────────────────────────
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=

# 계좌가 필요한 API의 기본 계좌 (GET /api/v1/accounts 응답의 accountSeq)
# 비워두면 계좌 필요 API 호출 시 account 인자를 명시해야 합니다.
TOSSINVEST_DEFAULT_ACCOUNT=

# ─────────────────────────────────────────────────────────────
# OpenAPI 명세 / API 서버
# ─────────────────────────────────────────────────────────────
TOSSINVEST_OPENAPI_URL=https://openapi.tossinvest.com/openapi-docs/latest/openapi.json
TOSSINVEST_BASE_URL=https://openapi.tossinvest.com
TOSSINVEST_ALLOW_CUSTOM_BASE_URL=false
TOSSINVEST_OPENAPI_STRICT=true
TOSSINVEST_SPEC_CACHE_ENABLED=true

# ─────────────────────────────────────────────────────────────
# 실주문 안전정책 (기본값 유지 권장)
# ─────────────────────────────────────────────────────────────
TOSSINVEST_ENABLE_TRADING=false
TOSSINVEST_ENABLE_CONDITIONAL_ORDERS=false
TOSSINVEST_MUTATION_CONFIRMATION=I_UNDERSTAND_THIS_PLACES_A_REAL_ORDER

# ─────────────────────────────────────────────────────────────
# 네트워크 / 토큰
# ─────────────────────────────────────────────────────────────
TOSSINVEST_TOKEN_EXPIRY_SKEW_SECONDS=60
TOSSINVEST_REQUEST_TIMEOUT_MS=30000
TOSSINVEST_MAX_READ_RETRIES=2
TOSSINVEST_MAX_RESPONSE_BYTES=8388608

# ─────────────────────────────────────────────────────────────
# 기타
# ─────────────────────────────────────────────────────────────
TOSSINVEST_LOG_LEVEL=info
TOSSINVEST_ENABLE_RAW_REQUESTS=false
TOSSINVEST_RUN_LIVE_READONLY_TESTS=false
