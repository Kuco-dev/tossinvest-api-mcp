# 저장소에는 LF로 저장하고 체크아웃 시 OS 기본을 따른다.
* text=auto eol=lf

# 셸 스크립트는 Windows에서도 반드시 LF여야 한다 (Docker 빌드 등).
*.sh text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.ico binary

