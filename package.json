{
  "name": "tossinvest-api-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "토스증권 Open API를 실제로 호출하는 로컬 실행형 MCP(stdio) 서버",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "tossinvest-api-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:update": "tsx scripts/update-openapi.ts",
    "openapi:verify": "tsx scripts/verify-openapi.ts",
    "inspect": "npx --yes @modelcontextprotocol/inspector node dist/index.js",
    "docker:build": "docker compose build",
    "docker:run": "docker compose run --rm tossinvest-mcp",
    "docker:inspect": "docker compose --profile tools run --rm --service-ports inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "16.4.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.6",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.8"
  }
}
